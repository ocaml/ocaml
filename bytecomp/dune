(rule
 (target opcodes.ml)
 (mode   fallback)
 (deps   ../runtime/caml/opcodes.h)
 (action
   (with-stdout-to %{target}
     (system
       "%{read-lines:../build-aux/cpp} -I ../runtime %{dep:opcodes.ml.c}"
       ))))
